---
import Section from './Section.astro';
import { experience, education } from '../content/profile';
import { monthStartEpoch, monthStartLabel } from '../lib/epoch';
---

<Section id="experience" command="git log --author=logan" title="Experience">
  <div class="space-y-7">
    {
      experience.map((r) => (
        <article class="grid gap-1 sm:grid-cols-[8.5rem_1fr] sm:gap-5">
          <p class="font-mono text-xs text-mute sm:pt-1">
            <span class="text-acc" aria-hidden="true" data-epoch title={`Unix time for ${monthStartLabel(r.since)}`}>{monthStartEpoch(r.since)}</span>
            <br class="hidden sm:block" />
            <span class="sm:hidden" aria-hidden="true"> · </span>
            {r.start} – {r.end}
          </p>
          <div>
            <h3 class="text-lg font-semibold">
              {r.title} <span class="font-normal text-mute">· {r.company}{r.place && `, ${r.place}`}</span>
            </h3>
            <p class="mt-1.5 leading-relaxed text-mute">{r.summary}</p>
            {r.highlights && (
              <ul class="mt-3 space-y-1.5">
                {r.highlights.map((h) => (
                  <li class="relative pl-5 leading-relaxed before:absolute before:left-0 before:font-mono before:text-acc before:content-['→']">{h}</li>
                ))}
              </ul>
            )}
            {r.stack && <p class="mt-3 font-mono text-xs text-mute">{r.stack}</p>}
          </div>
        </article>
      ))
    }
  </div>
  <div class="mt-8 grid gap-1 sm:grid-cols-[8.5rem_1fr] sm:gap-5">
    <p class="font-mono text-xs text-acc sm:pt-1">education</p>
    <ul>
      {education.map((e) => <li>{e.title}{e.place && <span class="text-mute"> · {e.place}</span>}</li>)}
    </ul>
  </div>
</Section>
