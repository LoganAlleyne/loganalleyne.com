---
interface Props {
  id: string;
  command: string;
  title: string;
}
const { id, command, title } = Astro.props;
---

<section id={id} class="reveal scroll-mt-6 border-t border-line py-10" aria-labelledby={`${id}-heading`}>
  <p class="cmd" aria-hidden="true"><b>$</b> {command}</p>
  <h2 id={`${id}-heading`} class="mt-1 mb-5 font-display text-2xl font-bold">{title}</h2>
  <slot />
</section>
