---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Logan Alleyne" description="This page does not exist.">
  <div class="mx-auto max-w-4xl px-4 py-20 sm:px-7">
    <div class="panel p-6">
      <p class="font-mono text-sm text-acc" aria-hidden="true">~ $ cd {Astro.url.pathname}</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold">404: page not found</h1>
      <p class="mt-2 text-mute">That page doesn't exist, or it has moved.</p>
      <p class="mt-4 font-mono text-sm text-mute" aria-hidden="true">exit 1</p>
    </div>
    <a href="/" class="mt-6 inline-block font-mono text-sm no-underline hover:text-acc">← Back to home</a>
  </div>
</Base>
